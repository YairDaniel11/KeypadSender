<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBgMain"
    android:orientation="vertical">

    <!-- סרגל עליון (Material 3): כותרת + כפתור הגדרות גלוי -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?attr/colorHeader"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/title_main"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/btn_history"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/bgIconBtn"
            android:contentDescription="@string/btn_history"
            android:scaleType="center"
            android:src="@drawable/ic_history"
            android:tint="?attr/colorTextPrimary"
            android:nextFocusDown="@+id/btn_goto_call"
            android:nextFocusUp="@+id/btn_send" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/bgIconBtn"
            android:contentDescription="@string/btn_settings"
            android:scaleType="center"
            android:src="@drawable/ic_settings"
            android:tint="?attr/colorTextPrimary"
            android:nextFocusDown="@+id/btn_goto_call"
            android:nextFocusUp="@+id/btn_send" />
    </LinearLayout>

    <!-- סטטוס -->
    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:background="?attr/bgCard"
        android:paddingBottom="6dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:textColor="?attr/colorAccent"
        android:textSize="12sp" />

    <!-- מעבר מהיר לשיחה פעילה (מוצג רק בזמן שיחה) -->
    <Button
        android:id="@+id/btn_goto_call"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="?attr/bgBtnTonal"
        android:minHeight="0dp"
        android:text="@string/btn_goto_call"
        android:textColor="?attr/colorTextPrimary"
        android:textSize="14sp"
        android:nextFocusUp="@id/btn_settings"
        android:nextFocusDown="@+id/rb_ext1" />

    <!-- בחירת שלוחה -->
    <RadioGroup
        android:id="@+id/ext_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="?attr/bgCard"
        android:orientation="horizontal"
        android:paddingEnd="4dp"
        android:paddingStart="4dp">
    </RadioGroup>

    <!-- בחירת שלוחה כשיש יותר מ-4: רשימה נפתחת בשורה אחת (חוסך מקום למסך) -->
    <Spinner
        android:id="@+id/ext_spinner"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="?attr/bgCard"
        android:visibility="gone"
        android:nextFocusUp="@id/btn_goto_call"
        android:nextFocusDown="@+id/input" />

    <!-- חלונית הטקסט: גדולה, עם מסגרת וסמן גלויים -->
    <EditText
        android:id="@+id/input"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:background="?attr/bgInput"
        android:cursorVisible="true"
        android:gravity="top|start"
        android:hint="@string/hint_input"
        android:inputType="textMultiLine|textNoSuggestions"
        android:minHeight="72dp"
        android:padding="8dp"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        android:textSize="20sp"
        android:nextFocusUp="@id/rb_ext1"
        android:nextFocusDown="@+id/btn_clear" />

    <!-- אזהרה + נקה -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/warn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_clear"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="?attr/bgBtnTonal"
            android:minHeight="0dp"
            android:minWidth="64dp"
            android:paddingEnd="10dp"
            android:paddingStart="10dp"
            android:text="@string/btn_clear"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="12sp"
            android:nextFocusUp="@id/input"
            android:nextFocusDown="@+id/btn_send" />
    </LinearLayout>

    <!-- תצוגה מקדימה של ההקשות -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:background="?attr/bgCard"
        android:orientation="vertical"
        android:paddingBottom="4dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:paddingTop="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_preview"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="start"
            android:layoutDirection="ltr"
            android:maxLines="1"
            android:textColor="?attr/colorTextPrimary"
            android:textDirection="ltr"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- שליחה -->
    <Button
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/bgBtnFilled"
        android:text="@string/btn_send"
        android:textColor="?attr/colorOnAccent"
        android:textSize="18sp"
        android:textStyle="bold"
        android:nextFocusUp="@id/btn_clear"
        android:nextFocusDown="@id/btn_settings" />

</LinearLayout>
