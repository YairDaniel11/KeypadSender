<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="?attr/bgCard"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/colorAccent"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/row_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/bgInput"
        android:gravity="start"
        android:hint="@string/hint_ext_label"
        android:inputType="text"
        android:maxLength="30"
        android:minHeight="44dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:singleLine="true"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        
        android:textSize="16sp" />

    <EditText
        android:id="@+id/row_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/bgInput"
        android:gravity="start"
        android:hint="@string/hint_ext_number"
        android:inputType="phone"
        
        android:minHeight="44dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:singleLine="true"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        android:textDirection="ltr"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/row_seq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/bgInput"
        android:gravity="start"
        android:hint="@string/hint_ext_seq"
        android:inputType="textNoSuggestions"
        android:maxLength="40"
        android:minHeight="44dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:singleLine="true"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        android:textDirection="ltr"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/row_suffix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?attr/bgInput"
        android:gravity="start"
        android:hint="@string/hint_ext_suffix"
        android:inputType="textNoSuggestions"
        android:maxLength="10"
        android:minHeight="44dp"
        android:paddingEnd="12dp"
        android:paddingStart="12dp"
        android:singleLine="true"
        android:textColor="?attr/colorTextPrimary"
        android:textColorHint="?attr/colorTextSecondary"
        android:textDirection="ltr"
        android:textSize="16sp" />
</LinearLayout>
