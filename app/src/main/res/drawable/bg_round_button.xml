<?xml version="1.0" encoding="utf-8"?>
<!-- צבעים קונקרטיים בלבד: ?attr בתוך drawable נתמך רק מ-API 21 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_teal" />
            <stroke android:width="4dp" android:color="@color/focus_green" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_green" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_teal" />
            <stroke android:width="2dp" android:color="@color/accent_teal" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
