<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- חיוג אוטומטי לקו -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- זיהוי מצב שיחה (PHONE_STATE) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- זיהוי המספר שאליו מחייגים (NEW_OUTGOING_CALL) -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- שליחת הקשות בתוך שיחה קיימת: שירות קצר + מצב צלילים -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.GET_TASKS" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_action_call"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ExtSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".HelpActivity"
            android:exported="false" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false" />

        <!-- משימה נפרדת: בסגירה חוזרים למסך השיחה ולא לאפליקציה -->
        <activity
            android:name=".AdConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <service
            android:name=".InCallSendService"
            android:exported="false" />

        <!-- receiver סטטי: מקבל שידורי מערכת גם כשהאפליקציה לא פתוחה -->
        <receiver
            android:name=".CallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
